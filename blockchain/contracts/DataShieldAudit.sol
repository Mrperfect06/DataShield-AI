pragma solidity ^0.8.20;

/**
 * @title  DataShieldAudit
 * @author DataShield AI Team
 * @notice Immutable on-chain audit trail for database-access events and
 *         security threat alerts generated by the DataShield ML pipeline.
 * @dev    Every access event is indexed by its keccak-256 hash.  When the
 *         attached threat score meets or exceeds the configurable threshold,
 *         an alert is created automatically.  Alerts can also be raised
 *         manually and later marked as resolved.
 */
contract DataShieldAudit {
    // ───────────────────────── Structs ─────────────────────────────────────

    /// @notice A single database-access event captured by the ML pipeline.
    struct AccessEvent {
        bytes32 eventHash;        // keccak-256 hash identifying this event
        uint256 timestamp;        // block timestamp at logging time
        string  userId;           // ID of the database user
        string  action;           // SQL action type (SELECT, DELETE, …)
        string  tableName;        // fully-qualified table name
        uint8   threatScore;      // ML-assigned threat score (0-100)
        string  ipfsReportHash;   // IPFS CID of the full GenAI report
    }

    /// @notice A security alert raised either automatically or manually.
    struct ThreatAlert {
        uint256 alertId;          // monotonically increasing identifier
        bytes32 eventHash;        // the triggering access event
        string  threatLevel;      // human-readable level: LOW / MEDIUM / HIGH / CRITICAL
        uint256 timestamp;        // block timestamp at creation time
        address responderAddress; // address that resolved the alert (zero if open)
        bool    resolved;         // whether the alert has been resolved
    }

    /// @notice A planted honey token decoy recorded on-chain prior to breaches.
    struct HoneyToken {
        bytes32 tokenHash;        // keccak256 hash of decoy identifier & seed
        string  tokenType;        // canary_record, decoy_api_key, watermarked_pii
        string  targetTable;      // table where token is planted
        uint256 plantedTimestamp; // when token was registered
        bool    tripped;          // true once accessed maliciously
        string  suspectUserId;    // identity of culprit who touched it
        string  proofIpfsCid;     // IPFS hash of forensic Proof of Theft
        uint256 trippedTimestamp; // timestamp when trap sprang
    }

    // ───────────────────────── State ──────────────────────────────────────

    /// @dev Contract deployer — the only address permitted to update settings.
    address public owner;

    /// @dev Lookup table: eventHash → AccessEvent.
    mapping(bytes32 => AccessEvent) private _accessEvents;

    /// @dev Lookup table: alertId  → ThreatAlert.
    mapping(uint256 => ThreatAlert) private _threatAlerts;

    /// @dev Lookup table: tokenHash → HoneyToken.
    mapping(bytes32 => HoneyToken) private _honeyTokens;

    /// @dev Ordered list of every recorded event hash (for enumeration).
    bytes32[] private _eventHashes;

    /// @dev Ordered list of every alert ID (for enumeration).
    uint256[] private _alertIds;

    /// @dev Ordered list of every registered honey token hash.
    bytes32[] private _honeyTokenHashes;

    /// @dev Threat-score threshold above which an alert is auto-created.
    uint8 public alertThreshold = 70;

    /// @dev Monotonically increasing counter for the next alert ID.
    uint256 private _nextAlertId = 1;

    // ───────────────────────── Events ─────────────────────────────────────

    /// @notice Emitted when a new access event is recorded.
    event AccessEventLogged(
        bytes32 indexed eventHash,
        string  userId,
        uint8   threatScore,
        uint256 timestamp
    );

    /// @notice Emitted when a new threat alert is created.
    event ThreatAlertCreated(
        uint256 indexed alertId,
        bytes32 indexed eventHash,
        string  threatLevel,
        uint256 timestamp
    );

    /// @notice Emitted when an existing alert is marked as resolved.
    event ThreatAlertResolved(
        uint256 indexed alertId,
        address resolver,
        uint256 timestamp
    );

    /// @notice Emitted when the owner changes the auto-alert threshold.
    event ThresholdUpdated(uint8 oldThreshold, uint8 newThreshold);

    /// @notice Emitted when a new honey token decoy is registered on-chain.
    event HoneyTokenPlanted(
        bytes32 indexed tokenHash,
        string  tokenType,
        string  targetTable,
        uint256 timestamp
    );

    /// @notice Emitted when an unauthorized user trips a honey token trap.
    event HoneyTokenTripped(
        bytes32 indexed tokenHash,
        string  suspectUserId,
        string  proofIpfsCid,
        uint256 timestamp
    );

    // ───────────────────────── Modifiers ──────────────────────────────────

    /// @dev Restricts a function to the contract owner.
    modifier onlyOwner() {
        require(msg.sender == owner, "DataShieldAudit: caller is not the owner");
        _;
    }

    // ───────────────────────── Constructor ────────────────────────────────

    /**
     * @notice Deploys the contract and sets the caller as owner.
     */
    constructor() {
        owner = msg.sender;
    }

    // ───────────────────────── Write Functions ────────────────────────────

    /**
     * @notice Log a new database-access event on-chain.
     * @dev    If `threatScore` >= `alertThreshold`, an alert is created
     *         automatically with a threat level derived from the score.
     * @param eventHash      Unique keccak-256 identifier for this event.
     * @param userId         Database user who performed the action.
     * @param action         SQL action type (e.g. "SELECT", "DELETE").
     * @param tableName      Fully-qualified table name.
     * @param threatScore    ML-assigned score in the range 0–100.
     * @param ipfsReportHash IPFS CID of the GenAI report (may be empty).
     */
    function logAccessEvent(
        bytes32 eventHash,
        string calldata userId,
        string calldata action,
        string calldata tableName,
        uint8   threatScore,
        string calldata ipfsReportHash
    ) external {
        // Prevent duplicate event hashes
        require(
            _accessEvents[eventHash].timestamp == 0,
            "DataShieldAudit: event hash already logged"
        );
        require(eventHash != bytes32(0), "DataShieldAudit: event hash cannot be zero");
        require(threatScore <= 100, "DataShieldAudit: threat score must be 0-100");

        // Store the access event
        _accessEvents[eventHash] = AccessEvent({
            eventHash:      eventHash,
            timestamp:      block.timestamp,
            userId:         userId,
            action:         action,
            tableName:      tableName,
            threatScore:    threatScore,
            ipfsReportHash: ipfsReportHash
        });
        _eventHashes.push(eventHash);

        emit AccessEventLogged(eventHash, userId, threatScore, block.timestamp);

        // Auto-create an alert if the score meets the threshold
        if (threatScore >= alertThreshold) {
            string memory level = _deriveThreatLevel(threatScore);
            _createAlert(eventHash, level);
        }
    }

    /**
     * @notice Manually create a threat alert for an existing event.
     * @param eventHash   Hash of a previously logged access event.
     * @param threatLevel Human-readable level (e.g. "HIGH").
     */
    function createThreatAlert(
        bytes32 eventHash,
        string calldata threatLevel
    ) external {
        require(
            _accessEvents[eventHash].timestamp != 0,
            "DataShieldAudit: event does not exist"
        );
        require(
            bytes(threatLevel).length > 0,
            "DataShieldAudit: threat level cannot be empty"
        );

        _createAlert(eventHash, threatLevel);
    }

    /**
     * @notice Mark an existing alert as resolved.
     * @param alertId The ID of the alert to resolve.
     */
    function resolveAlert(uint256 alertId) external {
        ThreatAlert storage alert = _threatAlerts[alertId];
        require(alert.timestamp != 0, "DataShieldAudit: alert does not exist");
        require(!alert.resolved,       "DataShieldAudit: alert already resolved");

        alert.resolved         = true;
        alert.responderAddress = msg.sender;

        emit ThreatAlertResolved(alertId, msg.sender, block.timestamp);
    }

    /**
     * @notice Update the auto-alert threshold.  Owner only.
     * @param newThreshold New threshold value (0–100).
     */
    function updateThreshold(uint8 newThreshold) external onlyOwner {
        require(newThreshold <= 100, "DataShieldAudit: threshold must be 0-100");

        uint8 old = alertThreshold;
        alertThreshold = newThreshold;

        emit ThresholdUpdated(old, newThreshold);
    }

    // ───────────────────────── Read Functions ─────────────────────────────

    /**
     * @notice Retrieve a stored access event by its hash.
     * @param eventHash The event hash to look up.
     * @return The AccessEvent struct.
     */
    function getAccessEvent(bytes32 eventHash)
        external
        view
        returns (AccessEvent memory)
    {
        require(
            _accessEvents[eventHash].timestamp != 0,
            "DataShieldAudit: event does not exist"
        );
        return _accessEvents[eventHash];
    }

    /**
     * @notice Retrieve a threat alert by its ID.
     * @param alertId The alert ID to look up.
     * @return The ThreatAlert struct.
     */
    function getThreatAlert(uint256 alertId)
        external
        view
        returns (ThreatAlert memory)
    {
        require(
            _threatAlerts[alertId].timestamp != 0,
            "DataShieldAudit: alert does not exist"
        );
        return _threatAlerts[alertId];
    }

    /**
     * @notice Return every recorded event hash.
     * @return An array of bytes32 hashes.
     */
    function getAllEventHashes() external view returns (bytes32[] memory) {
        return _eventHashes;
    }

    /**
     * @notice Return every alert ID.
     * @return An array of uint256 IDs.
     */
    function getAllAlertIds() external view returns (uint256[] memory) {
        return _alertIds;
    }

    /**
     * @notice Return the total number of logged access events.
     */
    function getEventCount() external view returns (uint256) {
        return _eventHashes.length;
    }

    /**
     * @notice Return the total number of alerts (resolved + unresolved).
     */
    function getAlertCount() external view returns (uint256) {
        return _alertIds.length;
    }

    /**
     * @notice Return all alerts that have not yet been resolved.
     * @return An array of ThreatAlert structs.
     */
    function getUnresolvedAlerts()
        external
        view
        returns (ThreatAlert[] memory)
    {
        // First pass: count unresolved alerts
        uint256 unresolvedCount = 0;
        for (uint256 i = 0; i < _alertIds.length; i++) {
            if (!_threatAlerts[_alertIds[i]].resolved) {
                unresolvedCount++;
            }
        }

        // Second pass: populate the result array
        ThreatAlert[] memory result = new ThreatAlert[](unresolvedCount);
        uint256 idx = 0;
        for (uint256 i = 0; i < _alertIds.length; i++) {
            if (!_threatAlerts[_alertIds[i]].resolved) {
                result[idx] = _threatAlerts[_alertIds[i]];
                idx++;
            }
        }

        return result;
    }

    // ───────────────────────── Internal Helpers ───────────────────────────

    /**
     * @dev Internal function that creates a ThreatAlert and emits the event.
     * @param eventHash   Hash of the triggering access event.
     * @param threatLevel Human-readable severity label.
     */
    function _createAlert(
        bytes32 eventHash,
        string memory threatLevel
    ) internal {
        uint256 alertId = _nextAlertId;
        _nextAlertId++;

        _threatAlerts[alertId] = ThreatAlert({
            alertId:          alertId,
            eventHash:        eventHash,
            threatLevel:      threatLevel,
            timestamp:        block.timestamp,
            responderAddress: address(0),
            resolved:         false
        });
        _alertIds.push(alertId);

        emit ThreatAlertCreated(alertId, eventHash, threatLevel, block.timestamp);
    }

    // ───────────────────────── Honey Token Decoy Functions ───────────────────

    /**
     * @notice Plants a honey token hash into the on-chain registry prior to a breach.
     * @param tokenHash   Keccak-256 hash identifying the planted decoy record.
     * @param tokenType   Categorical decoy type (canary_record, decoy_api_key, etc.).
     * @param targetTable Database schema where decoy is planted.
     */
    function plantHoneyToken(
        bytes32 tokenHash,
        string calldata tokenType,
        string calldata targetTable
    ) external onlyOwner {
        require(_honeyTokens[tokenHash].plantedTimestamp == 0, "Token already planted");
        _honeyTokens[tokenHash] = HoneyToken({
            tokenHash: tokenHash,
            tokenType: tokenType,
            targetTable: targetTable,
            plantedTimestamp: block.timestamp,
            tripped: false,
            suspectUserId: "",
            proofIpfsCid: "",
            trippedTimestamp: 0
        });
        _honeyTokenHashes.push(tokenHash);

        emit HoneyTokenPlanted(tokenHash, tokenType, targetTable, block.timestamp);
    }

    /**
     * @notice Registers tripwire execution when a user accesses or leaks a honey token.
     *         Instantly creates a CRITICAL security alert and locks proof of theft.
     * @param tokenHash     Keccak-256 hash of the tripped honey token.
     * @param suspectUserId Identity of user who accessed the decoy.
     * @param proofIpfsCid  IPFS hash of the certified Proof of Theft certificate.
     */
    function tripHoneyToken(
        bytes32 tokenHash,
        string calldata suspectUserId,
        string calldata proofIpfsCid
    ) external {
        HoneyToken storage token = _honeyTokens[tokenHash];
        require(token.plantedTimestamp != 0, "Honey token not registered");
        require(!token.tripped, "Honey token already tripped");

        token.tripped = true;
        token.suspectUserId = suspectUserId;
        token.proofIpfsCid = proofIpfsCid;
        token.trippedTimestamp = block.timestamp;

        _createAlert(tokenHash, "CRITICAL_HONEYTOKEN_THEFT");

        emit HoneyTokenTripped(tokenHash, suspectUserId, proofIpfsCid, block.timestamp);
    }

    /**
     * @notice Returns metadata for a registered honey token.
     */
    function getHoneyToken(bytes32 tokenHash) external view returns (HoneyToken memory) {
        require(_honeyTokens[tokenHash].plantedTimestamp != 0, "Token not found");
        return _honeyTokens[tokenHash];
    }

    /**
     * @notice Returns all planted honey token hashes for verification.
     */
    function getAllHoneyTokenHashes() external view returns (bytes32[] memory) {
        return _honeyTokenHashes;
    }

    /**
     * @dev Derive a human-readable threat level from a numeric score.
     * @param score Threat score in 0–100.
     * @return A string: "MEDIUM", "HIGH", or "CRITICAL".
     */
    function _deriveThreatLevel(uint8 score)
        internal
        pure
        returns (string memory)
    {
        if (score >= 90) return "CRITICAL";
        if (score >= 80) return "HIGH";
        return "MEDIUM";
    }
}
